# ==============================================================================
# EduMind AI - Backend Environment Configuration (.env.example)
# Copy this file to .env in the backend directory and configure as needed.
# Note: Real .env files must never be committed to source control.
# ==============================================================================

# Application Environment (development | production | testing)
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# SQLite Database Connection URL
# For production, ensure this path points to a persistent volume (e.g., /data/edumind.db)
DATABASE_URL=sqlite:///./edumind.db

# Allowed CORS Origins (comma-separated list for frontend access)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Document Upload Limit (Default: 10485760 bytes = 10 MB)
MAX_UPLOAD_SIZE_BYTES=10485760

# Authentication & JWT Security Settings
SECRET_KEY=edumind-super-secret-jwt-signing-key-production-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Gemini AI API Configuration
# Paste your Gemini API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
# OPENAI_API_KEY=your_openai_api_key_here
